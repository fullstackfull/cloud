includes:
    - tools/phpstan/vendor/larastan/larastan/extension.neon

parameters:
    level: 8

    paths:
        - apps/control-plane/src
        - apps/control-plane/app
        - apps/control-plane/database
        - apps/control-plane/routes

    excludePaths:
        analyse:
            - apps/control-plane/vendor

    # Domain modules must not reach into another module's Infrastructure layer.
    # Enforced additionally by an architecture test in the backend test suite.
    ignoreErrors: []

    checkMissingCallableSignature: true
    treatPhpDocTypesAsCertain: false
