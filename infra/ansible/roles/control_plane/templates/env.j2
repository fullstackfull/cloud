# Rendered by Ansible on the target. Never committed.
#
# Every value below comes from the deployment controller's environment. If a
# variable is unset there, the render fails rather than writing an empty secret
# that the application would then treat as configured.
APP_ENV={{ lynomia_environment }}
APP_DEBUG=false
APP_KEY={{ lookup('env', 'LYNOMIA_APP_KEY') | mandatory }}
APP_URL=https://{{ lynomia_public_hostname }}

DB_CONNECTION=pgsql
DB_HOST={{ lynomia_db_host }}
DB_PORT={{ lynomia_db_port | default(5432) }}
DB_DATABASE={{ lynomia_db_name }}
DB_USERNAME={{ lynomia_db_user }}
DB_PASSWORD={{ lookup('env', 'LYNOMIA_DB_PASSWORD') | mandatory }}

REDIS_HOST={{ lynomia_redis_host }}
REDIS_PORT={{ lynomia_redis_port | default(6379) }}
REDIS_PASSWORD={{ lookup('env', 'LYNOMIA_REDIS_PASSWORD') | mandatory }}

# Provider credentials. Absent here means the provider is not configured, and
# the application refuses to use a fake in a non-local environment.
PROXMOX_API_URL={{ lynomia_proxmox_api_url | default('') }}
PROXMOX_TOKEN_ID={{ lookup('env', 'LYNOMIA_PROXMOX_TOKEN_ID') | default('', true) }}
PROXMOX_TOKEN_SECRET={{ lookup('env', 'LYNOMIA_PROXMOX_TOKEN_SECRET') | default('', true) }}
CLOUDFLARE_API_TOKEN={{ lookup('env', 'LYNOMIA_CLOUDFLARE_API_TOKEN') | default('', true) }}
