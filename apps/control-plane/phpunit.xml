<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnNotice="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerErrors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!--
            Tests run against PostgreSQL, not SQLite.

            The schema uses jsonb columns, timezone-aware timestamps, partial
            and expression indexes, and SELECT ... FOR UPDATE SKIP LOCKED for
            IP and capacity allocation. None of that behaves identically on
            SQLite, and a green suite on an engine the platform never deploys
            to would be worse than no suite at all.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="lynomia_test"/>
        <env name="DB_USERNAME" value="lynomia"/>
        <env name="DB_URL" value=""/>

        <!--
            Pinned here rather than left to a dotenv file.

            The suite used to get these from an untracked .env.testing, which
            meant the result depended on a file that was on every developer's
            machine and in nobody's clone: a fresh checkout failed 23 tests, and
            the failure was a 500 from "Session store not set on request" rather
            than anything that named the cause. A test suite whose outcome
            depends on a file git does not have is not a test suite.

            Tests\TestCase presents `Origin: config('app.url')` so that the test
            client looks like the SPA rather than a third-party site; that only
            works if the host it names is one Sanctum considers stateful.
        -->
        <env name="APP_URL" value="http://localhost"/>
        <env name="FRONTEND_URL" value="http://localhost:5173"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost,localhost:5173,127.0.0.1"/>
        <env name="SESSION_DOMAIN" value="localhost"/>

        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>

        <!-- Fake providers are the only providers permitted in the test suite. -->
        <env name="COMPUTE_PROVIDER" value="fake"/>
        <env name="DEDICATED_PROVIDER" value="fake"/>
        <env name="HOSTING_PROVIDER" value="fake"/>
        <env name="DNS_PROVIDER" value="fake"/>
        <env name="PAYMENT_PROVIDER" value="fake"/>
        <env name="BACKUP_PROVIDER" value="fake"/>

        <env name="BILLING_DEFAULT_CURRENCY" value="KWD"/>
    </php>
</phpunit>
