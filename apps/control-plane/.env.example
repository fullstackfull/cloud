# =============================================================================
# Lynomia Cloud — control plane
#
# Copy to .env and fill in. NEVER commit a populated .env file.
# Values marked REQUIRED-IN-PRODUCTION must be set before deploying.
# =============================================================================

APP_NAME="Lynomia Cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=en,ar

# URL of the React SPA. Used for CORS, Sanctum stateful domains and for
# building links in outbound email.
FRONTEND_URL=http://localhost:5173

# --- Logging -----------------------------------------------------------------
# Production uses the structured JSON channel so Grafana Alloy can ship to Loki.
LOG_CHANNEL=stack
LOG_STACK=structured
LOG_LEVEL=debug

# --- Database ----------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lynomia
DB_USERNAME=lynomia
DB_PASSWORD=

# --- Redis / queues / cache --------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=localhost
QUEUE_CONNECTION=redis

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# --- Mail --------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@lynomia.local"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# BILLING
# =============================================================================
BILLING_DEFAULT_CURRENCY=KWD
BILLING_INVOICE_NUMBER_PREFIX=LYN
BILLING_INVOICE_NUMBER_PADDING=6
# Days after the due date before a service is suspended.
BILLING_GRACE_PERIOD_DAYS=7
# Days after suspension before a service is terminated.
BILLING_TERMINATION_AFTER_DAYS=14
# Days a customer has to pay an issued invoice before it is overdue. Distinct
# from the grace period: this is a commercial term printed on the document,
# while the grace period is how long the service keeps running past it.
BILLING_PAYMENT_TERMS_DAYS=7
# Surplus from an overpayment is credited to the customer's wallet rather than
# refunded: a wallet credit is instant and free, a refund takes days and costs
# a provider fee.
BILLING_CREDIT_OVERPAYMENT_TO_WALLET=true

# =============================================================================
# PROVIDERS
#
# Fake providers are for local development and automated tests only. The
# application refuses to boot with any of them enabled when APP_ENV=production.
# =============================================================================
COMPUTE_PROVIDER=fake            # fake | proxmox
DEDICATED_PROVIDER=fake          # fake | redfish | ilo | ipmi
HOSTING_PROVIDER=fake            # fake | cpanel | directadmin
DNS_PROVIDER=fake                # fake | cloudflare
PAYMENT_PROVIDER=fake            # fake | stripe | myfatoorah
BACKUP_PROVIDER=fake             # fake | pbs

# --- Proxmox VE --------------------------------------------------------------
# API token authentication only. Never a root password, never UI scraping.
PROXMOX_API_URL=                 # https://pve-01.example.internal:8006/api2/json
PROXMOX_TOKEN_ID=                # lynomia@pve!control-plane
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_TLS=true
PROXMOX_TIMEOUT_SECONDS=30
PROXMOX_NODE_CPU_OVERCOMMIT_RATIO=4.0
PROXMOX_NODE_MEMORY_HEADROOM_PERCENT=10

# --- Placement -----------------------------------------------------------------
# A node stops being schedulable past this much of its usable capacity. The
# remaining headroom is what absorbs a failure elsewhere in the cluster: fill
# every node to 95% and there is nowhere to evacuate to.
COMPUTE_CAPACITY_THRESHOLD_PERCENT=85
# Hard anti-affinity limit before the scheduler falls back to scoring. A
# customer buying three machines for redundancy who gets three on one node has
# bought none.
COMPUTE_MAX_CUSTOMER_VMS_PER_NODE=1

# --- Provisioning ----------------------------------------------------------------
PROVISIONING_TIMEOUT_SECONDS=900
PROVISIONING_MAX_ATTEMPTS=3
# How long a terminal job's reserved resources stay held before the reaper may
# release them. The reaper still refuses to touch a reservation whose job is
# still running: a slow hypervisor is not a dead job.
PROVISIONING_RESERVATION_TTL=3600
PROVISIONING_RECONCILE_MINUTES=30

# --- Dedicated servers (BMC) -------------------------------------------------
# BMC endpoints live on the isolated management network and are configured
# per-server in the infrastructure inventory, not here. These are defaults only.
REDFISH_VERIFY_TLS=true
REDFISH_TIMEOUT_SECONDS=60
IPMI_TIMEOUT_SECONDS=60

# --- Shared hosting ----------------------------------------------------------
# cPanel/WHM, DirectAdmin, CloudLinux and LiteSpeed are commercial products.
# Without a valid licence their installers stop and report LICENSE_REQUIRED.
CPANEL_VERIFY_TLS=true
CPANEL_TIMEOUT_SECONDS=60
DIRECTADMIN_VERIFY_TLS=true
DIRECTADMIN_TIMEOUT_SECONDS=60

# --- DNS ---------------------------------------------------------------------
# Never exposed to frontend clients.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Payments ----------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Reject webhook events whose timestamp is older than this, to bound replay.
# Must be the secret of the endpoint that actually delivers to THIS environment:
# a test-mode secret on a live endpoint fails verification silently.
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_API_VERSION=

MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_WEBHOOK_SECRET=

# --- Monitoring --------------------------------------------------------------
PROMETHEUS_URL=
# The metrics endpoint is never public: these figures disclose customer counts,
# capacity headroom and revenue. An unset token disables the endpoint rather
# than leaving it open.
PROMETHEUS_METRICS_TOKEN=
METRICS_ENABLED=true
METRICS_PATH=metrics
METRICS_CACHE_SECONDS=10

# --- Shared hosting ---------------------------------------------------------------
# Disk is the tightest threshold on purpose. A shared node that fills up does
# not degrade; it stops accepting mail and breaks every site on it at once.
HOSTING_MAX_DISK_PERCENT=75
HOSTING_MAX_LOAD_AVERAGE=8.0
HOSTING_MAX_ACCOUNTS_PER_NODE=250
# Suspension preserves everything and is reversible: most suspensions are
# billing disputes that end with the customer paying.
HOSTING_SUSPENDED_RETENTION_DAYS=30
HOSTING_LICENCE_RECHECK_HOURS=12

# --- Dedicated servers -------------------------------------------------------------
# A PXE authorisation is a recorded decision with an expiry, not a standing
# configuration. A machine left booting PXE reinstalls itself at the next power
# cut, which is a customer's entire server erased.
PXE_AUTHORISATION_TTL_MINUTES=60
PXE_INSTALL_TIMEOUT_MINUTES=90
# An order with no matching free hardware waits for an operator rather than
# failing: a customer content to wait a day is worth more than a refund.
DEDICATED_RESERVATION_HOLD_MINUTES=120

# --- Abuse controls ----------------------------------------------------------
# Outbound SMTP is blocked for customer VPS by default; approval is manual.
VPS_BLOCK_OUTBOUND_SMTP=true

# --- Security ----------------------------------------------------------------
# Comma-separated origins permitted to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Enforces HSTS and secure cookies. Must be true in production.
FORCE_HTTPS=false

# Addresses of the load balancers in front of this application. NEVER "*": a
# wildcard lets any client spoof X-Forwarded-For and defeat every rate limit.
TRUSTED_PROXIES=
