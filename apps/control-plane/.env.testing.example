# Environment for the automated test suite.
#
# The suite runs against a real PostgreSQL database, not SQLite: the schema
# relies on jsonb, timezone-aware timestamps and SELECT ... FOR UPDATE SKIP
# LOCKED, none of which behave the same on SQLite. A green suite on an engine
# the platform never deploys to would be worse than no suite at all.
#
# Copy to .env.testing and run `php artisan key:generate --env=testing`.

APP_NAME="Lynomia Cloud (testing)"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lynomia_test
DB_USERNAME=lynomia
DB_PASSWORD=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Queue retry clocks (F-08). Each connection hands a still-reserved job to a
# second worker after retry_after seconds, so each must stay longer than the
# timeout of every worker popping from it — raise a clock and its timeout
# together. Horizon and queue:work refuse to start when one is not.
REDIS_QUEUE_RETRY_AFTER=180
REDIS_PROVISIONING_RETRY_AFTER=5760
REDIS_INFRASTRUCTURE_RETRY_AFTER=1860
HORIZON_PROVISIONING_TIMEOUT=5700
MAIL_MAILER=array
BCRYPT_ROUNDS=4

# Only fake providers are permitted in tests.
COMPUTE_PROVIDER=fake
DEDICATED_PROVIDER=fake
HOSTING_PROVIDER=fake
DNS_PROVIDER=fake
PAYMENT_PROVIDER=fake
BACKUP_PROVIDER=fake

BILLING_DEFAULT_CURRENCY=KWD

# The test client presents Origin: http://localhost (see Tests\TestCase).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1
