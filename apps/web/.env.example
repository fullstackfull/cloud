# Lynomia Cloud — customer portal
#
# Copy to .env. Everything here is baked into the JavaScript bundle at build
# time and is therefore public: it is served to every visitor and readable in
# devtools. Nothing secret belongs in this file, ever. No API key, no token, no
# webhook secret — if a value must stay private it belongs on the control plane,
# behind an endpoint.

# Where the browser sends API requests.
#
# The default is a same-origin path, which is what the Sanctum cookie session
# needs: a cross-origin request would drop the session cookie unless the two
# hosts are same-site. In development the Vite dev server proxies /api and
# /sanctum to VITE_API_URL below, so this stays a path there too.
#
# Set it to an absolute URL only when the portal and the API are deployed on
# genuinely same-site hosts (portal.example.com and api.example.com), and set
# SESSION_DOMAIN on the control plane to the shared parent accordingly.
VITE_API_BASE=/api/v1

# Where the dev server proxies /api and /sanctum. Development only — it has no
# effect on a production build, because the proxy does not exist there.
VITE_API_URL=http://localhost:8000

# Port for `npm run dev`.
WEB_PORT=5173
