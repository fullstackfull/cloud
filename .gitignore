# Dependencies
/node_modules
**/node_modules
**/vendor

# Build output
**/dist
**/build
**/.vite
**/public/build
**/public/hot

# Environment & secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Every *.example is a template with no secrets in it, and some of them are
# required: the CI backend job copies .env.testing.example before it can run a
# single test. The narrower `!**/.env.example` above matched only that one name,
# so .env.testing.example was silently ignored and the job could never have
# succeeded on a fresh checkout - the file existed on every developer machine
# and in nobody's clone.
!.env.*.example
!**/.env.*.example
*.pem
*.key
!**/*.pub
id_rsa*
id_ed25519*
**/vault-password*
**/*.vault
**/secrets.yml
!**/secrets.example.yml

# Laravel
apps/control-plane/storage/*.key
apps/control-plane/storage/framework/cache/*
apps/control-plane/storage/framework/sessions/*
apps/control-plane/storage/framework/views/*
apps/control-plane/storage/logs/*
apps/control-plane/bootstrap/cache/*
!**/.gitignore

# Tooling caches
.phpunit.result.cache
.phpunit.cache
.php-cs-fixer.cache
**/.pest
coverage/
**/coverage/
.eslintcache
*.tsbuildinfo

# Terraform / OpenTofu
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# Ansible
**/*.retry
infrastructure/ansible/inventories/*/host_vars/*/vault.yml
infrastructure/ansible/.ansible/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Laravel bootstrap cache is regenerated on every boot
apps/control-plane/bootstrap/cache/*.php

# Runtime artefacts that land in whatever directory a service was started from.
# dump.rdb was already listed here and was tracked anyway: an ignore rule added
# after a file is committed does nothing, which is exactly how a binary blob
# nobody reviews stays in a repository. It has been untracked.
dump.rdb
*.rdb
appendonly.aof
appendonlydir/

# Playwright output: traces and error-context snapshots from the last local run.
apps/web/test-results/
apps/web/playwright-report/

# Infrastructure state. OpenTofu state contains every value a provider returned,
# including secrets, so it lives in the deployment controller's backend and
# never here.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
infra/**/secrets/
infra/ansible/*.retry

# ansible-lint scratch
.ansible/

# Browser-suite run artifacts: the fake provider's recorded decisions and the
# test mail outbox. Written by a run, read by the harness, and never part of
# the source: a committed outbox would also carry the signed links from
# whoever ran the suite last.
apps/web/e2e/.artifacts/
