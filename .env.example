# =============================================================================
# Lynomia Cloud — root environment template
#
# Copy to .env and fill in. NEVER commit a populated .env.
# Application-specific variables live in apps/control-plane/.env.example.
# =============================================================================

# --- Local development services (docker-compose.dev.yml) ---------------------
DB_DATABASE=lynomia
DB_USERNAME=lynomia
DB_PASSWORD=change_me_locally
DB_PORT=5432

REDIS_PORT=6379

MAIL_PORT=1025
MAILPIT_UI_PORT=8025

API_PORT=8000
WEB_PORT=5173

# --- Ansible -----------------------------------------------------------------
# Path to the vault password file used to decrypt inventory secrets.
# Keep this OUTSIDE the repository.
ANSIBLE_VAULT_PASSWORD_FILE=

# Target environment for `make infra-check`, `make monitoring-deploy`, etc.
ENV=development
