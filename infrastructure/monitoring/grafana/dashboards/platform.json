    {
      "id": 2,
      "type": "stat",
      "title": "Control plane",
      "description": "Scrape health of the control plane's own metrics endpoint. When this is red every business panel below is stale rather than zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "lynomia-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"control-plane\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "lynomia-prometheus"
          },
          "legendFormat": "up",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
