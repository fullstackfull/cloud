    {
      "id": 6,
      "type": "stat",
      "title": "Provisioning success (30m)",
      "description": "Succeeded as a share of everything that reached a terminal state. needs_review counts as a failure here: from the customer's side it is one.",
      "datasource": {
        "type": "prometheus",
        "uid": "lynomia-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform:provisioning_success:ratio30m",
          "datasource": {
            "type": "prometheus",
            "uid": "lynomia-prometheus"
          },
          "legendFormat": "success",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.85
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
