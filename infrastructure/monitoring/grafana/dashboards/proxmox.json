{
  "uid": "lynomia-proxmox",
  "title": "Proxmox",
  "description": "Hypervisor cluster: node and storage availability, saturation, and allocated versus installed capacity.",
  "tags": [
    "lynomia",
    "compute"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Cluster",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Nodes online",
      "description": "PVE's own view. A node the cluster has fenced cannot run a guest even if its node_exporter is answering.",
      "datasource": {
        "type": "prometheus",
        "uid": "lynomia-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pve_up{id=~\"node/.*\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "lynomia-prometheus"
          },
          "legendFormat": "online",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "count(pve_up{id=~\"node/.*\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "lynomia-prometheus"
          },
          "legendFormat": "total",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Storages online",
      "description": "A storage PVE cannot reach stalls every guest with a disk on it and fails every backup to it.",
      "datasource": {
        "type": "prometheus",
        "uid": "lynomia-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pve_up{id=~\"storage/.*\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "lynomia-prometheus"
          },
          "legendFormat": "online",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "count(pve_up{id=~\"storage/.*\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "lynomia-prometheus"
          },
          "legendFormat": "total",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Guests",
      "description": "Every VM and container the cluster knows about.",
      "datasource": {
        "type": "prometheus",
        "uid": "lynomia-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(pve_guest_info)",
          "datasource": {
            "type": "prometheus",
            "uid": "lynomia-prometheus"
          },
          "legendFormat": "guests",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Worst CPU allocation",
      "description": "The most committed node in the cluster on CPU. When this reaches 1, the scheduler has nowhere left to place.",
      "datasource": {
        "type": "prometheus",
        "uid": "lynomia-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(lynomia_node_capacity_ratio{dimension=\"cpu\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "lynomia-prometheus"
          },
          "legendFormat": "ratio",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Worst memory allocation",
      "description": "Memory is the dimension that runs out first on a VPS platform, because it cannot be oversubscribed the way CPU can.",
      "datasource": {
        "type": "prometheus",
        "uid": "lynomia-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(lynomia_node_capacity_ratio{dimension=\"memory\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "lynomia-prometheus"
          },
          "legendFormat": "ratio",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Per node",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU utilisation",
      "description": "Reported by the hypervisor, across all cores. Sustained saturation reaches customers as steal time long before anything errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "lynomia-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "instance:node_cpu_utilisation:ratio5m{role=\"hypervisor\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "lynomia-prometheus"
          },
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisSoftMin": 0
          },
          "mappings": [],
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Memory utilisation",
      "description": "MemAvailable-based, not MemFree: free memory on a busy host is near zero by design because the page cache uses it.",
      "datasource": {
        "type": "prometheus",
        "uid": "lynomia-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "instance:node_memory_utilisation:ratio{role=\"hypervisor\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "lynomia-prometheus"
          },
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisSoftMin": 0
          },
          "mappings": [],
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Filesystem usage",
      "description": "Hypervisors alert at 88% used rather than the usual 90: below that, thin volumes stop growing and running guests pause rather than error.",
      "datasource": {
        "type": "prometheus",
        "uid": "lynomia-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "instance:node_filesystem_usage:ratio{role=\"hypervisor\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "lynomia-prometheus"
          },
          "legendFormat": "{{instance}} {{mountpoint}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisSoftMin": 0
          },
          "mappings": [],
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Network throughput",
      "description": "Per-node traffic. A single guest saturating an uplink degrades every other guest on the node.",
      "datasource": {
        "type": "prometheus",
        "uid": "lynomia-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{role=\"hypervisor\", device!~\"lo|veth.*|fw.*|tap.*\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "lynomia-prometheus"
          },
          "legendFormat": "{{instance}} rx",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{role=\"hypervisor\", device!~\"lo|veth.*|fw.*|tap.*\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "lynomia-prometheus"
          },
          "legendFormat": "{{instance}} tx",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisSoftMin": 0
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Allocation versus reality",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 13,
      "type": "table",
      "title": "Allocated capacity by node",
      "description": "What the control plane has committed, not what the hypervisor is using. The scheduler places against this number, so this is the one that decides whether the next order can be filled.",
      "datasource": {
        "type": "prometheus",
        "uid": "lynomia-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lynomia_node_capacity_ratio",
          "datasource": {
            "type": "prometheus",
            "uid": "lynomia-prometheus"
          },
          "legendFormat": "{{node}} / {{dimension}}",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": false
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Allocated versus used memory",
      "description": "A persistent gap between the two means the plans are sold larger than customers use \u2014 safe to oversubscribe further. The two converging means the opposite, urgently.",
      "datasource": {
        "type": "prometheus",
        "uid": "lynomia-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(lynomia_node_capacity_ratio{dimension=\"memory\"}) / count(lynomia_node_capacity_ratio{dimension=\"memory\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "lynomia-prometheus"
          },
          "legendFormat": "mean allocated",
          "range": true
        },
        {
          "refId": "B",
          "expr": "avg(instance:node_memory_utilisation:ratio{role=\"hypervisor\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "lynomia-prometheus"
          },
          "legendFormat": "mean used",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisSoftMin": 0
          },
          "mappings": [],
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
